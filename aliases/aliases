alias lah="ls -lah --color=auto"
alias ll="ls -la --color=auto"
alias l="ls -l --color=auto"

# GIT commit with date timestamp
commit () { git commit -m "commit $(date +%s)" -a; }

# Strip all blank lines from STDIN
sb () { grep -Ev '^($|[[:space:]]$)' -; }

# Strip all commented lines from STDIN
sc () { grep -Ev '^[[:space:]]*#' -; }

# Disable laptop screen and use only external display
alias fixscreens='xrandr --output HDMI-A-0 --auto --output eDP --off'
#

# GREP
alias grep='grep --color=auto'
alias gi='grep -i'
alias gr='grep -r'
alias gri='grep -ri'

# FZF
alias ff="fzf --preview 'cat -n {}'"

# cht.sh cheat sheets
#cht() { curl -s "cht.sh/${*// //}" | less -R; }
cht() {
    if [ $# -eq 0 ]; then
        curl -s "https://cht.sh"
    else
        local query=$(echo "$*" | tr ' ' '+')
        curl -s "https://cht.sh/${query}" | less -R
    fi
}


open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# BAT
alias cat='bat'

# GH
alias prs='gh pr list'
alias prc='gh pr create'

# CAPS2ESC
alias caps2esc='setxkbmap -option caps:escape'
alias caps2ctrl='setxkbmap -option ctrl:nocaps'
